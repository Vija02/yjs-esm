{
  "name": "yjs-esm",
  "version": "0.0.1",
  "description": "Bundles yjs for esm",
  "type": "module",
  "module": "./dist/SyncedStore-bundle.esm.js",
  "types": "./dist/SyncedStore-bundle.d.ts",
  "exports": {
    ".": {
      "import": "./dist/SyncedStore-bundle.esm.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.js && tsc && mv src/*.d.ts dist && rm -r dist/src && rm src/*.js* && rimraf dist/src",
    "agadoo": "agadoo",
    "test": "node Tests.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^19.0.0",
    "@rollup/plugin-node-resolve": "^13.0.0",
    "@rollup/plugin-typescript": "^8.2.1",
    "agadoo": "^2.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.52.7",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.6.2",
    "typescript": "^4.3.5"
  },
  "dependencies": {
    "yjs": "13.6.26"
  }
}
